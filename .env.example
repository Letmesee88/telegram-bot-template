# OpenAI / FoodAI
OPENAI_API_KEY="YOUR_OPENAI_KEY"
FOODAI_PROVIDER="openai"           # one of: stub, openai
FOODAI_DEFAULT_MODEL="gpt-5"
FOODAI_EDIT_MODEL="gpt-5"
# Optional: use GPT-5 Responses API instead of Chat Completions
FOODAI_API="responses"             # one of: chat, responses
FOODAI_REASONING_EFFORT="minimal"  # minimal|low|medium|high (responses API)
FOODAI_TEXT_VERBOSITY="low"       # low|medium|high (responses API)
FOODAI_CONFIDENCE_ESCALATE=0.70
FOODAI_TIMEOUT=20                 # seconds
FOODAI_IMAGE_DETAIL="low"
FOODAI_VISION_MODEL="gpt-4o-mini"
FOODAI_IMAGE_DETAIL_HIGH_RETRY=true
# OPENAI_BASE_URL="https://api.openai.com/v1"  # optional, only if using custom endpoint/proxy/Azure

# Recommendations (Approach B)
RECOMMENDATIONS_ENABLED=true
# Model for Responses API (same infra as FoodAI): gpt-5 or gpt-5-mini
RECOMMENDER_MODEL="gpt-5-mini"
# Max time to wait for recommendation (seconds)
RECOMMENDER_TIMEOUT=20
# Allow soft overshoot of daily calorie plan per single recommendation (percent)
RECOMMENDER_OVERSHOOT_CAL_PCT=5
# Avoid repeating the same dish title within N days
REC_AVOID_REPEAT_DAYS=3

# Performance Monitoring System Settings
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

# Alerts (Alertmanager Telegram Bot)
